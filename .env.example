# Required: MongoDB connection string (Atlas or local)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/to-do?retryWrites=true&w=majority
# Required: long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=

# Optional: API port (default 4000)
PORT=4000
# Optional: comma-separated allowed origins; empty = allow all
CORS_ORIGIN=
